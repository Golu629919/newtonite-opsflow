{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Newtonite OpsFlow Server (Full App)",
      "program": "${workspaceFolder}/server/index.js",
      "restart": true,
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "env": {
        "PORT": "3001"
      }
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Run Automated Critical Tests",
      "program": "${workspaceFolder}/scripts/run-tests.js",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    }
  ]
}
